<Window x:Class="ChatApp.View.ChatWindow"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ChatApp.View"
      mc:Ignorable="d" 
      Title="ChatApp" Height="400" Width="600">
    <Grid Background="LightYellow">
        <Button Content="Accept" HorizontalAlignment="Left" Margin="10,1,0,0" VerticalAlignment="Top" Height="24" Width="53" Command="{Binding InviteAccept}" IsEnabled="{Binding AcceptButtonEnabled}" Visibility="{Binding AcceptButtonVisibility}" Click="Button_Click_1" Background="Green"/>
        <TextBox Text="{Binding MyText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" Margin="127,321,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="375" Height="45" TextChanged="TextBox_TextChanged">
            <TextBox.InputBindings>
                <KeyBinding Command="{Binding EnterCommand}" Key="Enter" />
            </TextBox.InputBindings>
        </TextBox>
        <ListBox ItemsSource="{Binding Messages, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
             HorizontalAlignment="Left" 
             Margin="127,123,0,85" 
             Width="281" Background="White" SelectionChanged="ListBox_SelectionChanged_1"/>
        <Button Content="SEND &#xA;MESSAGE" HorizontalAlignment="Left" Margin="516,321,0,0" VerticalAlignment="Top" Height="45" Width="74" Command="{Binding EnterCommand}" Click="Button_Click"/>
        <Button Content="Decline" HorizontalAlignment="Left" Margin="10,30,0,0" VerticalAlignment="Top" Height="28" Width="53" Command="{Binding InviteDecline}" IsEnabled="{Binding DeclineButtonEnabled}" Visibility="{Binding DeclineButtonVisibility}" RenderTransformOrigin="0.68,0.295" Background="Red"/>
        <TextBox HorizontalAlignment="Left" Margin="19,262,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="165" Height="54" IsEnabled="False" Visibility="Hidden"/>
        <TextBlock HorizontalAlignment="Left" Margin="127,10,0,0" TextWrapping="Wrap" Text="{Binding Path=StatusText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Top" Height="44" Width="311" TextAlignment="Center" FontSize="20" FontWeight="Bold" FontStyle="Italic"/>

        <ListBox x:Name="ChatHistoryList" 
         ItemsSource="{Binding ChatHistoryItems}" 
         SelectedItem="{Binding SelectedChatHistory}" 
         Margin="476,63,16,85" 
         Background="Transparent">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="LightBlue" 
                    BorderBrush="DarkBlue" 
                    BorderThickness="1" 
                    CornerRadius="20" 
                    Height="30" 
                    HorizontalAlignment="Stretch" 
                    VerticalAlignment="Center" 
                    Padding="7">
                        
                        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <Ellipse Fill="SkyBlue" 
                             HorizontalAlignment="Center" 
                             VerticalAlignment="Center" 
                             Width="30" Height="20"/>

                            <TextBlock Text="{Binding ChatPeer}" 
                               VerticalAlignment="Center" 
                               HorizontalAlignment="Left" 
                               FontSize="14" 
                               FontWeight="Normal" 
                               Grid.Column="1" 
                               Margin="10,0,0,0"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>

            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="LightGray"/>
                            <Setter Property="BorderBrush" Value="Blue"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>


        <Grid HorizontalAlignment="Left" VerticalAlignment="Top" Margin="19,10,0,0">
            <TextBox x:Name="SearchBox" 
             HorizontalAlignment="Left" 
             VerticalAlignment="Top" 
             Width="106" 
             Height="30" 
             TextWrapping="Wrap" 
             Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
             Padding="30,0,0,0" 
             VerticalContentAlignment="Center" Margin="459,14,0,0"/>
            <TextBlock Text="&#xE10D;" 
               FontFamily="Segoe MDL2 Assets" 
               HorizontalAlignment="Left" 
               VerticalAlignment="Center" 
               Margin="553,0,0,0" 
               Foreground="White" RenderTransformOrigin="10.615,0.931"/>
        </Grid>
        <Button Content="BUZZ" HorizontalAlignment="Left" Margin="10,331,0,0" VerticalAlignment="Top" Width="73" Height="35" Command="{Binding BuzzCommand}" Background="DarkRed" RenderTransformOrigin="0.495,1.056"/>
    </Grid>
</Window>
