
data <- read.csv("data/optdigits.csv", header = FALSE)

p <- ncol(data)


data[[p]] <- as.factor(data[[p]])
names(data)[p] <- "digit"



set.seed(12345)

n <- nrow(data)

id_train <- sample(1:n, size = floor(0.5 * n))
train <- data[id_train, ]
id_remaining <- setdiff(1:n, id_train)
id_valid <- sample(id_remaining, size = floor(0.25 * n))
valid <- data[id_valid, ]
id_test <- setdiff(id_remaining, id_valid)
test <- data[id_test, ]

library(kknn)

f_knn <- digit ~ .

knn_train <- kknn(
  formula = f_knn,
  train = train, #used to train the model, 
  test = train, # how well the model learns.
  k = 30,
  kernel = "rectangular"
)

pred_train <- fitted(knn_train)

knn_test <- kknn(
  formula = f_knn,
  train = train,
  test = test,
  k = 30,
  kernel = "rectangular"
)

pred_test <- fitted(knn_test)


cm_train <- table(True = train$digit, Pred = pred_train)
cm_test  <- table(True = test$digit,  Pred = pred_test)

cat("\nConfusion matrix – TRAIN:\n")
print(cm_train)

cat("\nConfusion matrix – TEST:\n")
print(cm_test)


train_error <- mean(pred_train != train$digit)
test_error  <- mean(pred_test  != test$digit)

cat("\nTraining misclassification error:", train_error, "\n")
cat("Test misclassification error:",      test_error,  "\n")

#--------------------------#Q3---------------------------------
prob_train <- knn_train$prob          #display the probabilities for each digit 0-9              

idx_8 <- which(train$digit == "8")    # a vector of FLASE or TRUE created
prob_8 <- prob_train[idx_8, "8"]      # pick the row wheere 8 has the highest prob
rank_highest <- order(prob_8, decreasing = TRUE)    # sort from largest to lowest
easiest_idx <- idx_8[rank_highest[1:2]]              # the two highest

rank_lowest <- order(prob_8, decreasing = FALSE)
hardest_idx <- idx_8[rank_lowest[1:3]]

cat("the easiest 8's:\n")
print(easiest_idx)
cat("their probabilities P(class=8):\n")
print(prob_8[rank_highest[1:2]])

cat("\n Row in TRAIN of the hardest 8's:\n")
print(hardest_idx)
cat("their prob P(class=8):\n")
print(prob_8[rank_lowest[1:3]])


plot_heatmap <- function(x, main = ""){
  m <- matrix(as.numeric(x), nrow = 8, ncol = 8, byrow = TRUE)
  
  heatmap(
    m,
    Rowv = NA, Colv = NA,
    scale = "none",
    col = gray.colors(256),
    main = main,
    labRow = NA, labCol = NA
  )
}

par(mfrow = c(1, 2))
feature_cols <- 1:(p -1)

for (i in 1:2){
  row_idx <- easiest_idx[i]
  x <- train[row_idx, feature_cols]
  prob_val <- prob_8[rank_highest[i]]
  
  plot_heatmap(
    x,
    main = paste("easiest 8 #", i,
                 "\ntrain row", row_idx,
                 "\nP(class=8) =", round(prob_val, 3))
  )
}

par(mfrow = c(1, 3))

for (i in 1:3){
  row_idx <- hardest_idx[i]
  x <- train[row_idx, feature_cols]
  prob_val <- prob_8[rank_lowest[i]]
  
  plot_heatmap(
    x,
    main = paste("easiest 8 #", i,
                 "\ntrain row", row_idx,
                 "\nP(class=8) =", round(prob_val, 3))
  )
}

#---------------------Q4---------------------------------

ks <- 1:30

train_err <- numeric(length(ks))
valid_err <- numeric(length(ks))

for (i in seq_along(ks)){
  k_val <- ks[i]
  
  knn_train_k <- kknn(
    formula = f_knn,
    train = train,
    test = train,
    k = k_val,
    kernel  = "rectangular"
  )
  
  pred_train_k <- fitted(knn_train_k)
  train_err[i] <- mean(pred_train_k != train$digit)
  
  
  knn_valid_k <- kknn(
    formula = f_knn,
    train = train,
    test = valid,
    k = k_val,
    kernel  = "rectangular"
  )
  
  pred_valid_k <- fitted(knn_valid_k)
  valid_err[i] <- mean(pred_valid_k != train$digit)
}

cbind(K = ks, train_err, valid_err)


if (!is.null(dev.list())) dev.off()
par(mfrow = c(1,1), mar = c(4,4,2,1))

ylim_range <- range(c(train_err, valid_err))

plot(ks, train_err,
     type = "b", pch = 19,
     col  = "blue",
     ylim = ylim_range,
     xlab = "K (number of neighbors)",
     ylab = "Misclassification error",
     main = "Training vs validation error for k-NN")

lines(ks, valid_err,
      type = "b", pch = 19,
      col  = "red")

legend("right",
       legend = c("Training error", "Validation error"),
       col    = c("blue", "red"),
       lty    = 1, pch = 19)

