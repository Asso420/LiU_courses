cbind(K = ks, train_err, valid_err)
ks <- 1:30
ce_valid <- numeric(length(ks))  # cross-entropy on validation
for (i in seq_along(ks)) {
k_val <- ks[i]
# k-NN on validation data
knn_valid <- kknn(
formula = f_knn,
train   = train,
test    = valid,
k       = k_val,
kernel  = "rectangular"
)
prob_valid <- knn_valid$prob   # n_valid x 10 matrix of probabilities
y_true     <- valid$digit      # factor: true digits for validation set
# Ensure we align columns with class labels
class_names <- colnames(prob_valid)    # should be "0","1",...,"9"
idx_col     <- match(y_true, class_names)
# For each row i, p_true[i] = P(model assigns to the correct class of sample i)
p_true <- prob_valid[cbind(1:nrow(valid), idx_col)]
# Add small constant inside log to avoid log(0)
eps <- 1e-15
ce_valid[i] <- -mean(log(p_true + eps))
}
# Look at the K vs cross-entropy values
cbind(K = ks, ce_valid)
if (!is.null(dev.list())) dev.off()
par(mfrow = c(1,1), mar = c(4,4,2,1))
plot(ks, ce_valid,
type = "b", pch = 19,
xlab = "K (number of neighbors)",
ylab = "Validation cross-entropy",
main = "Validation cross-entropy vs K for k-NN")
# If you want the minimum point highlighted:
best_k <- ks[which.min(ce_valid)]
points(best_k, min(ce_valid), pch = 19, col = "red", cex = 1.5)
text(best_k, min(ce_valid),
labels = paste("Best K =", best_k),
pos = 3, col = "red")
View(prob_valid)
View(prob_valid)
View(valid)
