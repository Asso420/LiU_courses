from pyspark.sql import Row, SparkSession
from pyspark.sql import functions as F

APP_NAME = "Spark SQL Demo"
spark = SparkSession.builder \
    .appName(APP_NAME) \
    .getOrCreate()

sc = spark.sparkContext # create a SparkContext object to connect to the cluster

# 1. Read the file as an RDD (assignment 1 and 4)
hdfs_as_RDD_temp = sc.textFile("hdfs:///user/x_ahmso/BDA/input/temperature-readings.csv")
hdfs_as_RDD_precip = sc.textFile("hdfs:///user/x_ahmso/BDA/input/precipitation-readings.csv")
# 2. Parse into DataFrame Rows 
lines = hdfs_as_RDD_temp.map(lambda line: line.split(";")) #create an RDD of lists, where each list contains the fields of a line
line_precip = hdfs_as_RDD_precip.map(lambda line: line.split(";"))

# assignment 5
file_as_RDD_precip = sc.textFile("file:///home/x_ahmso/BDA-lab/input_data/precipitation-readings.csv")
file_as_RDD_ostgotland = sc.textFile("file:///home/x_ahmso/BDA-lab/input_data/stations-Ostergotland.csv")
lines_precip = file_as_RDD_precip.map(lambda line: line.split(";")) #create an RDD of lists, where each list contains the fields of a line
lines_ostgotland = file_as_RDD_ostgotland.map(lambda line: line.split(";")) # rdd of station names in Ostergotland region, which will be used for

# -----------------------assignment 1-----------------------------------------------
# structured_RDD_temp = lines.map(lambda x: Row(year = int(x[1][0:4]), stationID = x[0], temperature = float(x[3]))) 
# # 3. Create DataFrame and Filter Years
 df = spark.createDataFrame(structured_RDD_temp)
 filtered_df = df.filter((F.col('year') >= 1950) & (F.col('year') <= 2014))
 base_df = filtered_df.alias("base")

 max_temps = filtered_df.groupBy('year').agg(F.max('temperature').alias('maxValue')) 
 max_df = max_temps.alias("max") #max_df is a DataFrame that contains the maximum temperature for each year, with columns "year" and "maxValue"
 max_result = base_df.join(max_df, 
